{
  "manifest_version": 3,
  "name": "Mustang Housing Match",
  "version": "0.1.0",
  "description": "Capture off-campus rental listings and score them against a Cal Poly student's housing preferences.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.zillow.com/*",
    "https://*.craigslist.org/*",
    "https://*.apartments.com/*",
    "https://*.redfin.com/*",
    "https://*.facebook.com/*",
    "https://*.californiawest.com/*",
    "https://*.farrellsmyth.com/*",
    "https://*.rpmcentralcoast.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "action": { "default_title": "Open Mustang Housing Match" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
